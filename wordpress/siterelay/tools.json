        },
        "file": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "component",
        "file"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "write_file",
    "description": "Replace an existing theme or plugin file with WordPress’s native editor. Requires the revision from read_file. Show the diff and get confirmation first. Save the previous source for rollback.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "theme",
            "plugin"
          ]
        },
        "component": {
          "type": "string",
          "description": "Theme directory slug or plugin ID from site_status."
        },
        "file": {
          "type": "string"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "component",
        "file",
        "expected_revision",
        "content"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
