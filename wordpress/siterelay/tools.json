  {
    "name": "list_content",
    "description": "List a page of posts, pages or media. Use the IDs with get_content.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "page",
            "post",
            "attachment"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "search": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
